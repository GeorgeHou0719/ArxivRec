# Copy this file to .env for local live-model runs.
# Never commit the real .env file or paste API keys into chat.
OPENAI_API_KEY=
RESEND_API_KEY=
ARXIVREC_RECIPIENT=
ARXIVREC_EMAIL_FROM="ArxivRec <onboarding@resend.dev>"
# Optional for scheduled runs. Store the validated ResearchProfile as one JSON value.
ARXIVREC_PROFILE_JSON=
ARXIVREC_PROFILE_MODEL=gpt-5.4-mini
ARXIVREC_RANKING_MODEL=gpt-5.4-mini
ARXIVREC_EMBEDDING_MODEL=text-embedding-3-small
ARXIVREC_DATABASE_PATH=data/arxiv_rec.sqlite3
ARXIVREC_CACHE_DIR=data/cache
